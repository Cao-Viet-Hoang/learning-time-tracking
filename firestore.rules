rules_version = '2';

// Cadence - Learning Time Tracker
//
// The app signs in with "username + API key" (no Firebase Auth), so these
// rules cannot verify *who* is writing. Isolation between users is structural:
// every user's data lives under their own users/{userId} path, not in a shared
// collection. These rules just validate document shape to block malformed
// writes - they are not a security boundary (anyone with the public web API
// key could still read/write under any userId). Fine for a small, trusted set
// of users; add Firebase Authentication + request.auth.uid checks if that ever
// needs to change.

service cloud.firestore {
  match /databases/{database}/documents {

    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function isTime(v) { return v is string && v.matches('^[0-2][0-9]:[0-5][0-9]$'); }

    match /users/{userId} {
      allow read, write: if true;

      match /subjects/{id} {
        allow read: if true;
        allow delete: if true;
        allow create, update: if request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.archived is bool;
      }

      match /goals/{id} {
        allow read: if true;
        allow delete: if true;
        allow create, update: if request.resource.data.type in ['daily', 'monthly', 'yearly']
          && request.resource.data.targetMinutes is int
          && request.resource.data.targetMinutes > 0;
      }

      match /plannedSessions/{id} {
        allow read: if true;
        allow delete: if true;
        allow create, update: if isDate(request.resource.data.date)
          && isTime(request.resource.data.startTime)
          && isTime(request.resource.data.endTime)
          && request.resource.data.subjectId is string
          && request.resource.data.status in ['planned', 'completed', 'skipped'];
      }

      match /learningSessions/{id} {
        allow read: if true;
        allow delete: if true;
        allow create, update: if isDate(request.resource.data.date)
          && isTime(request.resource.data.startTime)
          && isTime(request.resource.data.endTime)
          && request.resource.data.durationMinutes is int
          && request.resource.data.durationMinutes > 0
          && request.resource.data.source in ['timer', 'manual'];
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
